# Firebase Web App config
EXPO_PUBLIC_FIREBASE_API_KEY=coloque_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Google Places deve usar chave separada da chave Firebase.
# Para producao, prefira chamar Google Places pelo backend.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=coloque_aqui

# Backend TRQ-BEC. Nunca coloque chave privada, segredo KMS ou credencial de
# servico em EXPO_PUBLIC_*: essas variaveis sao incorporadas ao aplicativo.
# O Expo Go usa a API HTTPS publica. Um IPv4 local so funciona se o backend
# tiver sido deliberadamente exposto na rede; 127.0.0.1 aponta para o celular.
EXPO_PUBLIC_TRQ_BEC_API_URL=https://api.liberrotas.com.br

# A Fase 1 nao autoriza efeitos comerciais em modo legado ou offline.
EXPO_PUBLIC_TRQ_BEC_ALLOW_LEGACY_DEMO=false
