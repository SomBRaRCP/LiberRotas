{
  "openapi": "3.1.0",
  "info": {
    "title": "TRQ-BEC LiberRotas API",
    "summary": "Fronteira autoritativa de segurança para emissão e resgate de cupons.",
    "description": "## Fronteira de segurança do LiberRotas\n\nA **TRQ-BEC LiberRotas API** é a camada autoritativa para cadastro de dispositivos,\nemissão de cupons, resgate com prova de posse e registro de evidências no ledger.\n\n### Autenticação\n\nAs operações protegidas exigem um **Firebase ID token** no esquema HTTP Bearer.\nNo botão **Authorize**, cole somente o token — a interface acrescenta `Bearer` automaticamente.\n\n### Regra criptográfica\n\nA decisão é *fail-closed*: se a verificação criptográfica não estiver íntegra,\na autorização não produz `ALLOW`. O estado do provider pode ser consultado em\n`GET /health/crypto`.\n\n### Estado desta versão\n\nA versão `0.5.0-alpha.2` mantém Ed25519 apenas como perfil de laboratório.\nML-KEM-768 e ML-DSA-65 permanecem bloqueados até a integração de um provider\nauditado e aprovado.",
    "contact": {
      "name": "Equipe TRQ-BEC / LiberRotas"
    },
    "version": "0.5.0a2"
  },
  "paths": {
    "/health/": {
      "get": {
        "tags": [
          "Saúde e prontidão"
        ],
        "summary": "Verificar a saúde da infraestrutura",
        "description": "Confirma conectividade com PostgreSQL e Redis e informa se a camada criptográfica pós-quântica está pronta. Endpoint público para sondas operacionais.",
        "operationId": "getInfrastructureHealth",
        "responses": {
          "200": {
            "description": "Estado consolidado da infraestrutura.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/crypto": {
      "get": {
        "tags": [
          "Saúde e prontidão"
        ],
        "summary": "Verificar o provider criptográfico",
        "description": "Expõe identidade, aprovação, autoteste e suporte algorítmico do provider. `ready=false` mantém os fluxos pós-quânticos bloqueados por construção.",
        "operationId": "getCryptoProviderHealth",
        "responses": {
          "200": {
            "description": "Estado detalhado do provider criptográfico.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CryptoHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/trq-bec/devices/enroll": {
      "post": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Cadastrar uma chave de dispositivo",
        "description": "Vincula a chave pública do dispositivo ao sujeito autenticado pelo Firebase. O cadastro é idempotente para a mesma identidade e falha com conflito quando há tentativa de reatribuição.",
        "operationId": "enrollDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dispositivo cadastrado ou já cadastrado para o mesmo sujeito.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "bearerAusente": {
                    "summary": "Cabeçalho Bearer ausente",
                    "value": {
                      "code": "AUTH_BEARER_REQUIRED",
                      "message": "AUTH_BEARER_REQUIRED"
                    }
                  },
                  "bearerInvalido": {
                    "summary": "Cabeçalho Bearer inválido",
                    "value": {
                      "code": "AUTH_BEARER_INVALID",
                      "message": "AUTH_BEARER_INVALID"
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Firebase ID token inválido",
                    "value": {
                      "code": "AUTH_TOKEN_INVALID",
                      "message": "AUTH_TOKEN_INVALID"
                    }
                  },
                  "sujeitoInvalido": {
                    "summary": "Sujeito do token inválido",
                    "value": {
                      "code": "AUTH_SUBJECT_INVALID",
                      "message": "AUTH_SUBJECT_INVALID"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A chave do dispositivo ou a chave pública já está vinculada a outra identidade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "identificadorJaVinculado": {
                    "summary": "Identificador de chave já vinculado",
                    "value": {
                      "code": "DEVICE_KEY_BINDING_CONFLICT",
                      "message": "DEVICE_KEY_BINDING_CONFLICT"
                    }
                  },
                  "chavePublicaJaVinculada": {
                    "summary": "Chave pública já vinculada",
                    "value": {
                      "code": "DEVICE_PUBLIC_KEY_ALREADY_BOUND",
                      "message": "DEVICE_PUBLIC_KEY_ALREADY_BOUND"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/issue": {
      "post": {
        "tags": [
          "Cupons"
        ],
        "summary": "Emitir um cupom protegido",
        "description": "Emite o envelope e o payload compacto de QR para um cupom ativo pertencente ao empreendedor. Exige claim `role=entrepreneur`, vínculo entre `issuer_id` e o Firebase UID e dispositivo previamente cadastrado.",
        "operationId": "issueCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCouponRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Payload compacto para QR e prazo de validade do envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueCouponResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "bearerAusente": {
                    "summary": "Cabeçalho Bearer ausente",
                    "value": {
                      "code": "AUTH_BEARER_REQUIRED",
                      "message": "AUTH_BEARER_REQUIRED"
                    }
                  },
                  "bearerInvalido": {
                    "summary": "Cabeçalho Bearer inválido",
                    "value": {
                      "code": "AUTH_BEARER_INVALID",
                      "message": "AUTH_BEARER_INVALID"
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Firebase ID token inválido",
                    "value": {
                      "code": "AUTH_TOKEN_INVALID",
                      "message": "AUTH_TOKEN_INVALID"
                    }
                  },
                  "sujeitoInvalido": {
                    "summary": "Sujeito do token inválido",
                    "value": {
                      "code": "AUTH_SUBJECT_INVALID",
                      "message": "AUTH_SUBJECT_INVALID"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo de emissor ou dispositivo necessário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "claimEmpreendedor": {
                    "summary": "Claim de empreendedor ausente",
                    "value": {
                      "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                      "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                    }
                  },
                  "vinculoEmissor": {
                    "summary": "Emissor não corresponde ao Firebase UID",
                    "value": {
                      "code": "ISSUER_BINDING_MISMATCH",
                      "message": "ISSUER_BINDING_MISMATCH"
                    }
                  },
                  "dispositivoNaoCadastrado": {
                    "summary": "Dispositivo emissor não cadastrado",
                    "value": {
                      "code": "DEVICE_NOT_ENROLLED",
                      "message": "DEVICE_NOT_ENROLLED"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cupom inexistente, inativo ou não pertencente ao emissor autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "cupomIndisponivel": {
                    "summary": "Cupom não está ativo ou não pertence ao emissor",
                    "value": {
                      "code": "COUPON_NOT_ACTIVE_OR_NOT_OWNED",
                      "message": "COUPON_NOT_ACTIVE_OR_NOT_OWNED"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Provider pós-quântico indisponível ou adaptação do envelope ainda não aprovada. A emissão falha fechada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "providerNaoPronto": {
                    "summary": "Provider pós-quântico não está pronto",
                    "value": {
                      "code": "PQC_PROVIDER_NOT_READY",
                      "message": "PQC_PROVIDER_NOT_READY"
                    }
                  },
                  "adaptadorPendente": {
                    "summary": "Adaptador de envelope aguarda aprovação",
                    "value": {
                      "code": "PQC_ENVELOPE_ADAPTER_PENDING_APPROVAL",
                      "message": "PQC_ENVELOPE_ADAPTER_PENDING_APPROVAL"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/redeem/begin": {
      "post": {
        "tags": [
          "Resgate"
        ],
        "summary": "Iniciar o resgate e emitir um desafio",
        "description": "Valida o vínculo do QR, o estado do token e o dispositivo do visitante. Cria uma operação, uma sessão e um desafio de uso único, retornando a mensagem exata que deverá ser assinada no dispositivo.",
        "operationId": "beginCouponRedemption",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeginRedemptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operação pendente, desafio de frescor e mensagem para prova de posse.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeginRedemptionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "bearerAusente": {
                    "summary": "Cabeçalho Bearer ausente",
                    "value": {
                      "code": "AUTH_BEARER_REQUIRED",
                      "message": "AUTH_BEARER_REQUIRED"
                    }
                  },
                  "bearerInvalido": {
                    "summary": "Cabeçalho Bearer inválido",
                    "value": {
                      "code": "AUTH_BEARER_INVALID",
                      "message": "AUTH_BEARER_INVALID"
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Firebase ID token inválido",
                    "value": {
                      "code": "AUTH_TOKEN_INVALID",
                      "message": "AUTH_TOKEN_INVALID"
                    }
                  },
                  "sujeitoInvalido": {
                    "summary": "Sujeito do token inválido",
                    "value": {
                      "code": "AUTH_SUBJECT_INVALID",
                      "message": "AUTH_SUBJECT_INVALID"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "QR inválido, vínculo inconsistente ou envelope criptográfico rejeitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "vinculoQrInvalido": {
                    "summary": "QR não corresponde ao token armazenado",
                    "value": {
                      "code": "QR_BINDING_MISMATCH",
                      "message": "QR_BINDING_MISMATCH"
                    }
                  },
                  "tokenCriptograficoInvalido": {
                    "summary": "Envelope criptográfico inválido",
                    "value": {
                      "code": "TOKEN_CRYPTO_INVALID",
                      "message": "TOKEN_CRYPTO_INVALID"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "O dispositivo do visitante não está cadastrado para a identidade autenticada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "dispositivoNaoCadastrado": {
                    "summary": "Dispositivo de resgate não cadastrado",
                    "value": {
                      "code": "DEVICE_NOT_ENROLLED",
                      "message": "DEVICE_NOT_ENROLLED"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Referência de token desconhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "tokenDesconhecido": {
                    "summary": "Referência do token não encontrada",
                    "value": {
                      "code": "TOKEN_REFERENCE_UNKNOWN",
                      "message": "TOKEN_REFERENCE_UNKNOWN"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Token já utilizado, retido ou em estado incompatível com novo resgate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "tokenNaoResgatavel": {
                    "summary": "Token não pode ser resgatado novamente",
                    "value": {
                      "code": "TOKEN_NOT_REDEEMABLE",
                      "message": "TOKEN_NOT_REDEEMABLE"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Token expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "tokenExpirado": {
                    "summary": "Prazo de validade do token encerrado",
                    "value": {
                      "code": "TOKEN_EXPIRED",
                      "message": "TOKEN_EXPIRED"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/redeem/authorize": {
      "post": {
        "tags": [
          "Resgate"
        ],
        "summary": "Autorizar o resgate mediante prova de posse",
        "description": "Consome o desafio de uso único, valida a assinatura do dispositivo, reserva replay de forma distribuída, executa os gates criptográficos e aplica a política determinística. Repetições da mesma operação são idempotentes.",
        "operationId": "authorizeCouponRedemption",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRedemptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Decisão autoritativa e referência de evidência no ledger.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "bearerAusente": {
                    "summary": "Cabeçalho Bearer ausente",
                    "value": {
                      "code": "AUTH_BEARER_REQUIRED",
                      "message": "AUTH_BEARER_REQUIRED"
                    }
                  },
                  "bearerInvalido": {
                    "summary": "Cabeçalho Bearer inválido",
                    "value": {
                      "code": "AUTH_BEARER_INVALID",
                      "message": "AUTH_BEARER_INVALID"
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Firebase ID token inválido",
                    "value": {
                      "code": "AUTH_TOKEN_INVALID",
                      "message": "AUTH_TOKEN_INVALID"
                    }
                  },
                  "sujeitoInvalido": {
                    "summary": "Sujeito do token inválido",
                    "value": {
                      "code": "AUTH_SUBJECT_INVALID",
                      "message": "AUTH_SUBJECT_INVALID"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Operação de resgate desconhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "operacaoDesconhecida": {
                    "summary": "Operação não encontrada",
                    "value": {
                      "code": "OPERATION_UNKNOWN",
                      "message": "OPERATION_UNKNOWN"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Reserva distribuída contra replay indisponível. A autorização falha fechada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "replayIndisponivel": {
                    "summary": "Armazenamento de replay indisponível",
                    "value": {
                      "code": "REPLAY_STORE_UNAVAILABLE",
                      "message": "REPLAY_STORE_UNAVAILABLE"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Código de motivo legível por máquina.",
            "examples": [
              "AUTH_TOKEN_INVALID"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Mensagem de erro legível por pessoa ou operador.",
            "examples": [
              "AUTH_TOKEN_INVALID"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorResponse",
        "description": "Envelope estável de erro retornado nas fronteiras de autenticação e serviço.",
        "examples": [
          {
            "code": "AUTH_TOKEN_INVALID",
            "message": "AUTH_TOKEN_INVALID"
          }
        ]
      },
      "AuthorizationResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "DENY",
              "ALLOW",
              "STEP_UP",
              "HOLD_OR_REVIEW"
            ],
            "title": "Decision",
            "description": "Decisão determinística de autorização."
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id",
            "description": "Identificador da operação de resgate."
          },
          "crypto_ok": {
            "type": "boolean",
            "title": "Crypto Ok",
            "description": "Indica se todos os gates criptográficos obrigatórios foram aprovados."
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes",
            "description": "Motivos legíveis por máquina que sustentam a decisão."
          },
          "coupon_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coupon Id",
            "description": "Cupom liberado somente quando a política permite sua exposição."
          },
          "event_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Ref",
            "description": "Referência do evento no ledger append-only."
          },
          "idempotent": {
            "type": "boolean",
            "title": "Idempotent",
            "description": "Verdadeiro quando se trata de repetição segura de uma operação já concluída.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "operation_id",
          "crypto_ok",
          "reason_codes"
        ],
        "title": "AuthorizationResponse",
        "examples": [
          {
            "coupon_id": "FEITUR-021",
            "crypto_ok": true,
            "decision": "ALLOW",
            "event_ref": "event:36cc48bf-908f-4b90-b91e-57951a97be10",
            "idempotent": false,
            "operation_id": "op:eea2915b-8783-4c98-9766-39df9c5fcf2e",
            "reason_codes": []
          }
        ]
      },
      "AuthorizeRedemptionRequest": {
        "properties": {
          "operation_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Operation Id",
            "description": "Identificador da operação retornado pela etapa de início.",
            "examples": [
              "op:eea2915b-8783-4c98-9766-39df9c5fcf2e"
            ]
          },
          "session_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Session Id",
            "description": "Identificador da sessão retornado pela etapa de início.",
            "examples": [
              "session:9d9f36e2-69ac-433d-a168-e4a4af1365ac"
            ]
          },
          "challenge_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 16,
            "title": "Challenge Id",
            "description": "Identificador do desafio de uso único retornado pela etapa de início.",
            "examples": [
              "challenge:8d74f40a-70f0-4aa1-ae42-ef6749b6020e"
            ]
          },
          "device_key_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 12,
            "title": "Device Key Id",
            "description": "Chave do dispositivo de resgate vinculada à operação.",
            "examples": [
              "device:expo:visitante:01"
            ]
