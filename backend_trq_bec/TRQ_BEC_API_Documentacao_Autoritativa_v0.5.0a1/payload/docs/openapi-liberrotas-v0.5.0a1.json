{
  "openapi": "3.1.0",
  "info": {
    "title": "TRQ-BEC LiberRotas API",
    "summary": "Fronteira autoritativa de segurança para emissão e resgate de cupons.",
    "description": "## Fronteira de segurança do LiberRotas\n\nA **TRQ-BEC LiberRotas API** é a camada autoritativa para cadastro de dispositivos,\nemissão de cupons, resgate com prova de posse e registro de evidências no ledger.\n\n### Autenticação\n\nAs operações protegidas exigem um **Firebase ID token** no esquema HTTP Bearer.\nNo botão **Authorize**, cole somente o token — a interface acrescenta `Bearer` automaticamente.\n\n### Regra criptográfica\n\nA decisão é *fail-closed*: se a verificação criptográfica não estiver íntegra,\na autorização não produz `ALLOW`. O estado do provider pode ser consultado em\n`GET /health/crypto`.\n\n### Estado desta versão\n\nA versão `0.5.0-alpha.1` mantém Ed25519 apenas como perfil de laboratório.\nML-KEM-768 e ML-DSA-65 permanecem bloqueados até a integração de um provider\nauditado e aprovado.",
    "contact": {
      "name": "Equipe TRQ-BEC / LiberRotas"
    },
    "version": "0.5.0a1"
  },
  "paths": {
    "/health/": {
      "get": {
        "tags": [
          "Saúde e prontidão"
        ],
        "summary": "Verificar a saúde da infraestrutura",
        "description": "Confirma conectividade com PostgreSQL e Redis e informa se a camada criptográfica pós-quântica está pronta. Endpoint público para probes de operação.",
        "operationId": "getInfrastructureHealth",
        "responses": {
          "200": {
            "description": "Estado consolidado da infraestrutura.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/crypto": {
      "get": {
        "tags": [
          "Saúde e prontidão"
        ],
        "summary": "Verificar o provider criptográfico",
        "description": "Expõe a identidade, aprovação, self-test e suporte algorítmico do provider. `ready=false` mantém os fluxos pós-quânticos bloqueados por construção.",
        "operationId": "getCryptoProviderHealth",
        "responses": {
          "200": {
            "description": "Estado detalhado do provider criptográfico.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CryptoHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/trq-bec/devices/enroll": {
      "post": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Cadastrar uma chave de dispositivo",
        "description": "Vincula a chave pública do dispositivo ao sujeito autenticado pelo Firebase. O cadastro é idempotente para a mesma identidade e falha com conflito quando há tentativa de reatribuição.",
        "operationId": "enrollDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dispositivo cadastrado ou já cadastrado para o mesmo sujeito.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollDeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "AUTH_TOKEN_INVALID",
                  "message": "AUTH_TOKEN_INVALID"
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo ou permissão necessária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                  "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de vínculo, repetição, token já utilizado ou operação já concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "TOKEN_NOT_REDEEMABLE",
                  "message": "TOKEN_NOT_REDEEMABLE"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/issue": {
      "post": {
        "tags": [
          "Cupons"
        ],
        "summary": "Emitir um cupom protegido",
        "description": "Emite o envelope e o payload compacto de QR para um cupom ativo pertencente ao empreendedor. Exige claim `role=entrepreneur`, vínculo entre `issuer_id` e o Firebase UID e dispositivo previamente cadastrado.",
        "operationId": "issueCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCouponRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Payload compacto para QR e prazo de validade do envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueCouponResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "AUTH_TOKEN_INVALID",
                  "message": "AUTH_TOKEN_INVALID"
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo ou permissão necessária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                  "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                }
              }
            }
          },
          "404": {
            "description": "Cupom inexistente, inativo ou não pertencente ao emissor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de vínculo, repetição, token já utilizado ou operação já concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "TOKEN_NOT_REDEEMABLE",
                  "message": "TOKEN_NOT_REDEEMABLE"
                }
              }
            }
          },
          "503": {
            "description": "Dependência crítica ou provider criptográfico indisponível. A operação falha fechada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "PQC_PROVIDER_NOT_READY",
                  "message": "PQC_PROVIDER_NOT_READY"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/redeem/begin": {
      "post": {
        "tags": [
          "Resgate"
        ],
        "summary": "Iniciar o resgate e emitir um desafio",
        "description": "Valida o vínculo do QR, o estado do token e o dispositivo do visitante. Cria uma operação, uma sessão e um desafio de uso único, retornando a mensagem exata que deverá ser assinada no dispositivo.",
        "operationId": "beginCouponRedemption",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeginRedemptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Operação pendente, desafio de frescor e mensagem para prova de posse.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeginRedemptionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "AUTH_TOKEN_INVALID",
                  "message": "AUTH_TOKEN_INVALID"
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo ou permissão necessária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                  "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                }
              }
            }
          },
          "400": {
            "description": "QR inválido ou vínculo criptográfico inconsistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Referência de token desconhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de vínculo, repetição, token já utilizado ou operação já concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "TOKEN_NOT_REDEEMABLE",
                  "message": "TOKEN_NOT_REDEEMABLE"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/v1/trq-bec/coupons/redeem/authorize": {
      "post": {
        "tags": [
          "Resgate"
        ],
        "summary": "Autorizar o resgate mediante prova de posse",
        "description": "Consome o desafio de uso único, valida a assinatura do dispositivo, reserva replay de forma distribuída, executa os gates criptográficos e aplica a política determinística. Repetições da mesma operação são idempotentes.",
        "operationId": "authorizeCouponRedemption",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRedemptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Decisão autoritativa e referência de evidência no ledger.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "AUTH_TOKEN_INVALID",
                  "message": "AUTH_TOKEN_INVALID"
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo ou permissão necessária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                  "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                }
              }
            }
          },
          "404": {
            "description": "Operação de resgate desconhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependência crítica ou provider criptográfico indisponível. A operação falha fechada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "PQC_PROVIDER_NOT_READY",
                  "message": "PQC_PROVIDER_NOT_READY"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    },
    "/internal/v1/ledger/checkpoint": {
      "post": {
        "tags": [
          "Operações internas"
        ],
        "summary": "Criar um checkpoint assinado do ledger",
        "description": "Operação administrativa que cobre a cadeia append-only atual, vincula a versão de política e assina o hash raiz com a chave de checkpoint. Exige custom claim `admin=true`.",
        "operationId": "createLedgerCheckpoint",
        "responses": {
          "200": {
            "description": "Checkpoint persistido e assinado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerCheckpointResponse"
                }
              }
            }
          },
          "401": {
            "description": "Firebase ID token ausente, malformado, expirado, revogado ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "AUTH_TOKEN_INVALID",
                  "message": "AUTH_TOKEN_INVALID"
                }
              }
            }
          },
          "403": {
            "description": "Identidade autenticada, porém sem claim, vínculo ou permissão necessária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "code": "ENTREPRENEUR_CLAIM_REQUIRED",
                  "message": "ENTREPRENEUR_CLAIM_REQUIRED"
                }
              }
            }
          },
          "409": {
            "description": "Ledger vazio ou estado incompatível com checkpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "FirebaseIDToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable reason code.",
            "examples": [
              "AUTH_TOKEN_INVALID"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human- or operator-readable error message.",
            "examples": [
              "AUTH_TOKEN_INVALID"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorResponse",
        "description": "Stable error envelope returned by authentication and service boundaries.",
        "examples": [
          {
            "code": "AUTH_TOKEN_INVALID",
            "message": "AUTH_TOKEN_INVALID"
          }
        ]
      },
      "AuthorizationResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "DENY",
              "ALLOW",
              "STEP_UP",
              "HOLD_OR_REVIEW"
            ],
            "title": "Decision",
            "description": "Deterministic authorization decision."
          },
          "operation_id": {
            "type": "string",
            "title": "Operation Id",
            "description": "Redemption operation identifier."
          },
          "crypto_ok": {
            "type": "boolean",
            "title": "Crypto Ok",
            "description": "Whether all mandatory cryptographic gates passed."
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes",
            "description": "Machine-readable reasons supporting the decision."
          },
          "coupon_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coupon Id",
            "description": "Coupon released only when policy permits disclosure."
          },
          "event_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Ref",
            "description": "Append-only ledger event reference."
          },
          "idempotent": {
            "type": "boolean",
            "title": "Idempotent",
            "description": "True when this is a safe replay of an already completed operation.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "operation_id",
          "crypto_ok",
          "reason_codes"
        ],
        "title": "AuthorizationResponse",
        "examples": [
          {
            "coupon_id": "FEITUR-021",
            "crypto_ok": true,
            "decision": "ALLOW",
            "event_ref": "event:36cc48bf-908f-4b90-b91e-57951a97be10",
            "idempotent": false,
            "operation_id": "op:eea2915b-8783-4c98-9766-39df9c5fcf2e",
            "reason_codes": []
          }
        ]
      },
      "AuthorizeRedemptionRequest": {
        "properties": {
          "operation_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Operation Id",
            "description": "Operation identifier returned by the begin step.",
            "examples": [
              "op:eea2915b-8783-4c98-9766-39df9c5fcf2e"
            ]
          },
          "session_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Session Id",
            "description": "Session identifier returned by the begin step.",
            "examples": [
              "session:9d9f36e2-69ac-433d-a168-e4a4af1365ac"
            ]
          },
          "challenge_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 16,
            "title": "Challenge Id",
            "description": "Single-use challenge identifier returned by the begin step.",
            "examples": [
              "challenge:8d74f40a-70f0-4aa1-ae42-ef6749b6020e"
            ]
          },
          "device_key_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 12,
            "title": "Device Key Id",
            "description": "Redeemer device key bound to the operation.",
            "examples": [
              "device:expo:visitante:01"
            ]
          },
          "device_proof_b64u": {
            "type": "string",
            "maxLength": 88,
            "minLength": 86,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Device Proof B64U",
            "description": "Ed25519 signature over `proof_message_b64u`, encoded as unpadded Base64URL.",
            "examples": [
              "9gAbmslLvGHuEFDf8h39jnVSrzC-ns48Boo5yHpFtOuXJEh3tockZ39gAbmslLvGHuEFDf8h39jnVSrzC-ns48"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "session_id",
          "challenge_id",
          "device_key_id",
          "device_proof_b64u"
        ],
        "title": "AuthorizeRedemptionRequest",
        "examples": [
          {
            "challenge_id": "challenge:8d74f40a-70f0-4aa1-ae42-ef6749b6020e",
            "device_key_id": "device:expo:visitante:01",
            "device_proof_b64u": "9gAbmslLvGHuEFDf8h39jnVSrzC-ns48Boo5yHpFtOuXJEh3tockZ39gAbmslLvGHuEFDf8h39jnVSrzC-ns48",
            "operation_id": "op:eea2915b-8783-4c98-9766-39df9c5fcf2e",
            "session_id": "session:9d9f36e2-69ac-433d-a168-e4a4af1365ac"
          }
        ]
      },
      "BeginRedemptionRequest": {
        "properties": {
          "qr_payload": {
            "$ref": "#/components/schemas/CompactQrPayload",
            "description": "QR payload produced by the issuance endpoint."
          },
          "device_key_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 12,
            "title": "Device Key Id",
            "description": "Previously enrolled redeemer device key.",
            "examples": [
              "device:expo:visitante:01"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "qr_payload",
          "device_key_id"
        ],
        "title": "BeginRedemptionRequest",
        "examples": [
          {
            "device_key_id": "device:expo:visitante:01",
            "qr_payload": {
              "expires_at": 1783811490,
              "issuer_ref": "issuer:4f1c5f4a93f2",
              "token_ref": "y2Q33r5Tgpiz7ibyWkFI9L7tt-Xah6un",
              "type": "trq-bec-coupon-v1",
              "v": 1
            }
          }
        ]
      },
      "BeginRedemptionResponse": {
        "properties": {
          "operation_id": {
            "type": "string",
            "title": "Operation Id",
            "description": "Stable identifier for the redemption operation.",
            "examples": [
              "op:eea2915b-8783-4c98-9766-39df9c5fcf2e"
            ]
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Session identifier bound to the challenge and device.",
            "examples": [
              "session:9d9f36e2-69ac-433d-a168-e4a4af1365ac"
            ]
          },
          "challenge": {
            "$ref": "#/components/schemas/ChallengeResponse"
          },
          "proof_message_b64u": {
            "type": "string",
            "title": "Proof Message B64U",
            "description": "Exact message bytes, encoded as unpadded Base64URL, that the device must sign.",
            "examples": [
              "VFJRLUJFQy9kZXZpY2UtcHJvb2YvdjE6ZXhhbXBsZS1wcm9vZi1tZXNzYWdl"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
