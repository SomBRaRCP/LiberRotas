TRQ_BEC_ENVIRONMENT=development
TRQ_BEC_HOST=0.0.0.0
TRQ_BEC_PORT=8787
TRQ_BEC_WORKERS=2
TRQ_BEC_FORWARDED_ALLOW_IPS=127.0.0.1

TRQ_BEC_DATABASE_URL=postgresql://trq_bec:troque_esta_senha@postgres:5432/trq_bec
TRQ_BEC_REDIS_URL=redis://redis:6379/0

TRQ_BEC_FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
TRQ_BEC_FIREBASE_PROJECT_ID=liberrotas-fe0af
TRQ_BEC_FIREBASE_CHECK_REVOKED=true

TRQ_BEC_ISSUER_PRIVATE_KEY_PATH=/run/secrets/issuer-ed25519.pem
TRQ_BEC_CHECKPOINT_PRIVATE_KEY_PATH=/run/secrets/checkpoint-ed25519.pem
TRQ_BEC_AUDIT_HMAC_KEY_PATH=/run/secrets/audit-hmac.key
TRQ_BEC_ISSUER_KEY_ID=issuer-lab-2026-01
TRQ_BEC_CHECKPOINT_KEY_ID=checkpoint-lab-2026-01
TRQ_BEC_LAB_SUITE_ENABLED=true

TRQ_BEC_PQC_PROVIDER_NAME=UNAVAILABLE
TRQ_BEC_PQC_PROVIDER_VERSION=0
TRQ_BEC_PQC_PROVIDER_APPROVED=false

TRQ_BEC_CORS_ORIGINS=https://app.liberrotas.com.br,http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8082,http://localhost:8082
TRQ_BEC_DOCS_ENABLED=true
TRQ_BEC_LIVE_OFFER_MAX_TTL_SECONDS=28800
TRQ_BEC_DEVICE_ENROLLMENT_MAX_AUTH_AGE_SECONDS=300
TRQ_BEC_DEVICE_AUTO_ACTIVATION_DELAY_SECONDS=600
TRQ_BEC_DEVICE_APPROVAL_TTL_SECONDS=1800
TRQ_BEC_DEVICE_APPROVAL_RESEND_COOLDOWN_SECONDS=60
TRQ_BEC_DEVICE_MAX_PENDING_PER_ACCOUNT=5
TRQ_BEC_PUBLIC_APP_URL=https://app.liberrotas.com.br

# Armazenamento privado de imagens no Google Cloud Storage.
# Com GCS_ENABLED=false, o backend deve continuar iniciando sem bucket ou credencial.
# A credencial local recomendada fica somente no arquivo montado no container da API.
# GCS_CREDENTIALS_JSON existe para injetores externos de segredo; nao grave JSON aqui.
TRQ_BEC_GCS_ENABLED=false
TRQ_BEC_GCS_PROJECT_ID=
TRQ_BEC_GCS_BUCKET_NAME=
TRQ_BEC_GCS_CREDENTIALS_FILE=/run/secrets/gcs-service-account.json
TRQ_BEC_GCS_CREDENTIALS_JSON=
TRQ_BEC_GCS_SIGNED_URL_EXPIRATION_SECONDS=600
TRQ_BEC_GCS_DOWNLOAD_URL_EXPIRATION_SECONDS=300
TRQ_BEC_GCS_UPLOAD_MAX_SIZE_BYTES=5242880
TRQ_BEC_GCS_PUBLIC_MEDIA_BASE_URL=
TRQ_BEC_GCS_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Politicas centralizadas da primeira fase: somente imagens JPEG, PNG e WebP.
TRQ_BEC_MEDIA_PENDING_EXPIRATION_SECONDS=86400
TRQ_BEC_MEDIA_ORPHAN_RETENTION_SECONDS=604800
TRQ_BEC_MEDIA_MAX_PENDING_PER_USER=10
TRQ_BEC_MEDIA_MAX_AVATAR_IMAGES=1
TRQ_BEC_MEDIA_MAX_LOGO_IMAGES=1
TRQ_BEC_MEDIA_MAX_PRODUCT_IMAGES=10
TRQ_BEC_MEDIA_MAX_POST_IMAGES=8
TRQ_BEC_MEDIA_MAX_FAIR_COVER_IMAGES=1
TRQ_BEC_MEDIA_IMAGE_MAX_PIXELS=40000000
TRQ_BEC_MEDIA_IMAGE_MAX_DIMENSION=4096

# Alerta de novo dispositivo. Em development pode ficar desativado para testes.
# Em production, TRQ_BEC_SMTP_HOST e TRQ_BEC_EMAIL_FROM sao obrigatorios e a API
# deve recusar a inicializacao sem eles, evitando dispositivos presos pendentes.
# A senha deve ficar em backend_trq_bec/secrets/smtp-password, nunca neste arquivo.
TRQ_BEC_SMTP_HOST=smtp-relay.brevo.com
TRQ_BEC_SMTP_PORT=587
# Usuario SMTP fornecido pelo Brevo. Nao presuma que seja igual ao remetente.
TRQ_BEC_SMTP_USERNAME=CHANGE_ME
# A chave SMTP deve ser gravada somente no secret montado em:
# /run/secrets/smtp-password
TRQ_BEC_SMTP_PASSWORD_PATH=/run/secrets/smtp-password
TRQ_BEC_SMTP_STARTTLS=true
TRQ_BEC_SMTP_SSL=false
TRQ_BEC_SMTP_TIMEOUT_SECONDS=10
TRQ_BEC_EMAIL_FROM=seguranca@liberrotas.com.br
